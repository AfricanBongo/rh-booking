{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "heroui-react": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@heroui/react-mcp@latest"
      ],
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "http://127.0.0.1:54321/mcp",
      "enabled": true
    },
    "coolify": {
      "type": "local",
      "command": ["npx", "-y", "@masonator/coolify-mcp"],
      "environment": {
        "COOLIFY_BASE_URL": "https://coolify.infra.worldsofhello.com",
        "COOLIFY_ACCESS_TOKEN": "{env:COOLIFY_WOH_API_KEY}"
      }
    }
  }
}