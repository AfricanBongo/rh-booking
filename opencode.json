{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "heroui-react": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@heroui/react-mcp@latest"
      ],
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "http://localhost:54321/mcp",
      "enabled": true
    },
    "magnific": {
      "type": "remote",
      "url": "https://mcp.magnific.com",
      "enabled": true
    }
  }
}