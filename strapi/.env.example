HOST=0.0.0.0
PORT=1337

# Database
# Dev: set these directly. Staging/Prod: Coolify injects SERVICE_USER_POSTGRESQL etc.
DATABASE_CLIENT=postgres
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change_me

# Strapi secrets (generate with: openssl rand -base64 32)
# JWT/keys: auto-generated by Coolify SERVICE_BASE64_64_* vars
# Salts: must be set manually as env vars in Coolify (not auto-generated)
APP_KEYS=key1,key2,key3,key4
ADMIN_JWT_SECRET=change_me
JWT_SECRET=change_me
API_TOKEN_SALT=change_me
TRANSFER_TOKEN_SALT=change_me
ENCRYPTION_KEY=change_me

# R2 (prod only -- activates S3-compatible upload provider)
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=
CF_R2_ENDPOINT=
CF_R2_PUBLIC_URL=

# Coolify-managed (do not set manually)
# SERVICE_FQDN_STRAPI        -- public FQDN assigned by Coolify
# SERVICE_URL_STRAPI_1337    -- internal URL
# SERVICE_USER_POSTGRESQL    -- auto-generated postgres user
# SERVICE_PASSWORD_POSTGRESQL -- auto-generated postgres password
# SERVICE_BASE64_64_SECRET   -- auto-generated 64-byte base64 secret
# SERVICE_BASE64_64_KEY      -- auto-generated 64-byte base64 key
# POSTGRESQL_DATABASE        -- defaults to "strapi"
