{
  "kind": "collectionType",
  "collectionName": "merch_items",
  "info": {
    "singularName": "merch-item",
    "pluralName": "merch-items",
    "displayName": "Merch item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "price": {
      "type": "integer"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "merch_status": {
      "type": "enumeration",
      "enum": ["open", "closed"]
    },
    "conferences": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::conference.conference"
    }
  }
}
