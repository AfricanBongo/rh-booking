{
  "kind": "collectionType",
  "collectionName": "dining_passes",
  "info": {
    "singularName": "dining-pass",
    "pluralName": "dining-passes",
    "displayName": "Dining Pass"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": { "type": "string", "required": true },
    "description": { "type": "text" },
    "price": { "type": "integer", "required": true },
    "meals_covered": { "type": "integer", "required": true },
    "conferences": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::conference.conference",
      "inversedBy": "dining_passes"
    }
  }
}
