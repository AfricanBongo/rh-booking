{
  "kind": "collectionType",
  "collectionName": "conferences",
  "info": {
    "singularName": "conference",
    "pluralName": "conferences",
    "displayName": "Conference"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "description": {
      "type": "richtext"
    },
    "start_date": {
      "type": "datetime"
    },
    "end_date": {
      "type": "datetime"
    },
    "check_in": {
      "type": "datetime",
      "required": false
    },
    "check_out": {
      "type": "datetime",
      "required": false
    },
    "payment_deadline": {
      "type": "datetime"
    },
    "location": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "portrait_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "other_images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    }
  }
}
